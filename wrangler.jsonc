{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilelog-lens",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "tilelog-lens.hamakyo.dev/*",
      "zone_name": "hamakyo.dev"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tilelog_lens",
      "database_id": "41150cf5-3c4b-4283-9f44-50d9ac11bade",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_ISSUER": "https://hamakyoh.cloudflareaccess.com",
    "ACCESS_JWKS_URL": "https://hamakyoh.cloudflareaccess.com/cdn-cgi/access/certs"
  }
}
